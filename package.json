{
  "name": "vest",
  "private": true,
  "version": "1.0.0",
  "description": "Vest - Fractional Real Estate Investment Platform in Mongolia",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server:dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "server:build": "tsc -p tsconfig.server.json",
    "server:start": "node dist/server.js",
    "db:migrate": "psql $DATABASE_URL -f schema.sql",
    "db:functions": "psql $DATABASE_URL -f migrations/001_stored_procedures.sql"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.12.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
