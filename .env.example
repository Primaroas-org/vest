# Vest Backend Environment Variables

# Server Configuration
NODE_ENV=development
PORT=3000

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here

# Database Configuration (for direct PostgreSQL access if needed)
DATABASE_URL=postgresql://user:password@localhost:5432/vest

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# e-Mongolia Integration (when ready for production)
# E_MONGOLIA_API_KEY=your-api-key
# E_MONGOLIA_API_SECRET=your-api-secret
# E_MONGOLIA_API_URL=https://api.e-mongolia.mn

# JWT Configuration (if using custom JWT)
# JWT_SECRET=your-super-secret-jwt-key
# JWT_EXPIRES_IN=7d

# Logging
LOG_LEVEL=info

# API Rate Limiting
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX_REQUESTS=100
