# Copy to .env and fill in your own values. Never commit .env.

# --- Frontend (Vite exposes only VITE_* variables to the browser) ---
# Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your-publishable-key

# --- Backend (Express API) ---
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:3001

SUPABASE_URL=https://your-project-ref.supabase.co
# Key the API uses for Supabase calls. A publishable key respects row-level security.
SUPABASE_SERVICE_KEY=sb_publishable_your-publishable-key
# Service-role key (server only, bypasses RLS). Needed for KYC document uploads to Storage.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Postgres connection used by Drizzle (Supabase > Project Settings > Database > Connection pooler)
DATABASE_URL="postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-your-region.pooler.supabase.com:6543/postgres"

# Logging
LOG_LEVEL=info
